rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins collection
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // Products collection: public read, authenticated admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categories collection: public read, authenticated admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Services collection: public read, authenticated admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Website Content (CMS): public read, authenticated admin write
    match /website_content/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reviews collection rules: public read & create, authenticated admin update/delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Orders collection: public read & create, authenticated admin update/delete
    match /orders/{orderId} {
      allow read: if true; 
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Promotions collection: public read, authenticated admin write
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Payment settings: public read, authenticated admin write
    match /payment_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customers collection: authenticated admin access
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }
  }
}
